<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PacmanManager.Worker.Test" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="11.0.0" />
        <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
        <PackageReference Include="Serilog.Settings.Configuration" Version="11.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.65.1" />
        <PackageReference Include="WolverineFx.Postgresql" Version="6.65.1" />
        <PackageReference Include="WolverineFx.RabbitMQ" Version="6.65.1" />
        <!-- Wolverine compiles its handler code at runtime, and the compiler is a package of its own. -->
        <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.65.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PacmanManager.Entities\PacmanManager.Entities.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
      <None Remove="appsettings.json" />
      <Content Include="appsettings.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
