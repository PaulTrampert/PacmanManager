# The one copy of the Postgres connection string the compose stack's services share. Every service
# that reads the database -- pacmanmanager.repohost, pacmanmanager.worker and
# pacmanmanager.migrations -- loads this file with `env_file`, and their appsettings.json files hold
# no default of their own, so the services cannot drift apart. The user and password are the
# `postgres` service's POSTGRES_USER and POSTGRES_PASSWORD in compose.yaml.
ConnectionStrings__pacmanmanager=Server=postgres;Database=pacmanmanager;User Id=pacmanmanager;Password=password;
