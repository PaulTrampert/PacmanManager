<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PacmanManager.RepoHost.Test" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
        <!-- Not used directly. Wolverine's runtime compiler and EF Core's design-time tools, which
             WolverineFx.EntityFrameworkCore brings in, ask for Roslyn 5.0.0 exactly, while
             PTrampert.SimplePatch needs its 5.9.0 compiler. These lift the rest of Roslyn to match,
             a mismatch NuGet otherwise warns about (NU1608). -->
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Scripting" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="PTrampert.QueryObjects" Version="1.8.0" />
        <PackageReference Include="PTrampert.SimplePatch" Version="2.0.4" />
        <PackageReference Include="PTrampert.SimplePatch.Swashbuckle" Version="2.0.4" />
        <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
        <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
        <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.64.0" />
        <PackageReference Include="WolverineFx.Postgresql" Version="6.64.0" />
        <PackageReference Include="WolverineFx.RabbitMQ" Version="6.64.0" />
        <!-- Wolverine compiles its generated message-handling code at runtime, and the compiler is a package of its own. -->
        <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.64.0" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
      <None Remove="pacman-local.conf" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\LibAlpmSharp\LibAlpmSharp.csproj" />
      <ProjectReference Include="..\PacmanManager.Authentication\PacmanManager.Authentication.csproj" />
      <ProjectReference Include="..\PacmanManager.CliTools\PacmanManager.CliTools.csproj" />
      <ProjectReference Include="..\PacmanManager.Commands\PacmanManager.Commands.csproj" />
      <ProjectReference Include="..\PacmanManager.Entities\PacmanManager.Entities.csproj" />
    </ItemGroup>

</Project>
