**/Dockerfile*
**/.git
**/.gitignore
**/.idea
**/.vscode
**/npm-debug.log
node_modules/
dist/
storybook-static/
coverage/
.tanstack/
*.gen.ts
__screenshots__/
.vitest-attachments/
*storybook.log
playwright-report/
test-results/
