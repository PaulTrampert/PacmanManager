{
  "name": "pacmanmanager-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "msw init",
    "generate": "tsr generate && node scripts/generate-api-schema.ts && node scripts/generate-validation.ts",
    "compose-up": "docker compose -f ../compose.yaml up -d --build",
    "predev": "npm run generate && npm run compose-up",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "vite build",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc",
    "prelint": "npm run generate",
    "lint": "eslint .",
    "pretest": "npm run generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "prestorybook": "npm run generate",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pree2e": "npm run compose-up",
    "e2e": "playwright test"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "msw-storybook-addon": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "storybook": "^10.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
